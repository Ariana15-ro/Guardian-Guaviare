# NASA FIRMS API map key (server-side only)
FIRMS_MAP_KEY=replace_with_your_firms_map_key

# ntfy.sh topic and bearer secret for the protected cron endpoint
NTFY_TOPIC=replace_with_a_unique_topic_name
CRON_SECRET=replace_with_a_long_random_secret

# Public URL of the dashboard, used as the notification click target
DASHBOARD_URL=https://your-dashboard.example

# Notification window in hours (defaults to 6)
NOTIFY_WINDOW_HOURS=6

# Optional: durable 24-hour notification deduplication
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
